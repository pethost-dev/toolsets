{
  "name": "pethost-toolsets",
  "version": "0.1.0",
  "description": "Drivers that give Claude's computer and browser toolsets and OpenAI's computer use, by toolsets and by code, the desktop and Chrome of a Pethost Agent Sandbox.",
  "keywords": [
    "pethost",
    "sandbox",
    "computer use",
    "browser use",
    "claude",
    "anthropic",
    "openai",
    "playwright",
    "ai agents"
  ],
  "homepage": "https://pethost.dev/docs/sandboxes/claude-and-openai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pethost-dev/toolsets.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/pethost-dev/toolsets/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./claude/computer": {
      "types": "./dist/claude/computer.d.ts",
      "default": "./dist/claude/computer.js"
    },
    "./claude/browser": {
      "types": "./dist/claude/browser.d.ts",
      "default": "./dist/claude/browser.js"
    },
    "./openai/computer": {
      "types": "./dist/openai/computer.d.ts",
      "default": "./dist/openai/computer.js"
    },
    "./openai/browser": {
      "types": "./dist/openai/browser.d.ts",
      "default": "./dist/openai/browser.js"
    },
    "./openai/code": {
      "types": "./dist/openai/code.d.ts",
      "default": "./dist/openai/code.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p examples --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pethost": "^0.10.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "openai": ">=7.64.0 <8",
    "playwright-core": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@types/node": "22.20.5",
    "openai": "7.64.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
}
